DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# mock = free fake bank page (default on this branch); zarinpal = real gateway
PAYMENT_BACKEND=mock
ZARINPAL_MERCHANT_CODE=sdgtgjhkyioplrndmkrtygfkdlserpwderds
ZARINPAL_SANDBOX=1
MINIMUM_ORDER_AMOUNT=100000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@productkrait.local
# Cache: redis | file | db | locmem | dummy (unset = redis if REDIS_URL, else locmem)
# On PythonAnywhere use CACHE_BACKEND=file (no Redis there).
CACHE_BACKEND=
REDIS_URL=
CACHE_DIR=
CACHE_TIMEOUT=300
# Production (PythonAnywhere): DJANGO_DEBUG=False, a real DJANGO_SECRET_KEY,
# DJANGO_ALLOWED_HOSTS=<user>.pythonanywhere.com and
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<user>.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0
