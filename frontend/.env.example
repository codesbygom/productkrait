# Where the Django backend runs. Used for server-side fetches and for the
# /api and /media proxy in next.config.ts.
BACKEND_URL=http://127.0.0.1:8000

# Public address of the Django site. Payment still goes through the Django
# checkout (bank gateway + session), so "Proceed to Payment" links here.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
